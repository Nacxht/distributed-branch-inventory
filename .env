# ============================================================
# Konfigurasi sistem stok terdistribusi
# Prioritas: flag CLI  >  .env  >  nilai default di kode
# Semua nilai di bawah OPSIONAL. Tanpa .env pun sistem jalan
# (default: 127.0.0.1, RPC 500N, RMI 600N, API 800N).
# ============================================================

# Host default untuk semua node (satu mesin)
HOST=127.0.0.1

# Kalau nanti node dipindah ke device lain, cukup buka komentar:
# HOST_NODE2=192.168.1.12
# HOST_NODE3=192.168.1.13
# HOST_NODE4=192.168.1.14

# Override port per node bila perlu (default: RPC=5000+N, RMI=6000+N, API=8000+N)
# RPC_PORT_NODE1=5001

# Parameter fault tolerance (dipakai di tahap berikutnya)
RPC_TIMEOUT=3
MAX_RETRY=3
